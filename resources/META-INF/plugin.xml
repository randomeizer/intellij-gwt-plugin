    <module name="org.randombits.intellij.gwt.spring"/>
    <module name="org.randombits.intellij.gwt.dev"/>
  </content>

  <depends optional="true" config-file="gwt-maven-support.xml">org.jetbrains.idea.maven</depends>
  <depends optional="true" config-file="gradle-support.xml">org.jetbrains.plugins.gradle</depends>
  <depends optional="true" config-file="javascript-debugger.xml">JavaScriptDebugger</depends>
  <vendor>Randombits</vendor>
  <category>JVM Frameworks</category>

  <extensionPoints>
    <extensionPoint name="devModeServerProvider" interface="org.randombits.intellij.gwt.run.GwtDevModeServerProvider" dynamic="true"/>
    <extensionPoint name="sdkType" interface="org.randombits.intellij.gwt.sdk.GwtSdkType" dynamic="true"/>
    <extensionPoint name="unregisteredServletFilter" interface="com.intellij.openapi.util.Condition" dynamic="true"/>
    <extensionPoint name="compileOutputRelativePathSuggester" interface="org.randombits.intellij.gwt.packaging.GwtCompileOutputRelativePathSuggester" dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="org.randombits.intellij.gwt">
    <devModeServerProvider implementation="org.randombits.intellij.gwt.run.DefaultDevModeServerProvider"/>
  </extensions>

