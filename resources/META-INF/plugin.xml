<idea-plugin>
  <name>Randombits GWT Support</name>
  <id>org.randombits.intellij.gwt</id>
  <description>
    <![CDATA[
      Simplifies development of web applications based on
      <a href="https://www.gwtproject.org/overview.html">Google Web Toolkit</a>.
        <ul>
        <li>Coding assistance specific to GWT: code completion, syntax and error highlighting with quick fixes, refactorings, and much more</li>
        <li>Dedicated run configurations</li>
        <li>Integration with the GWT compiler</li>
        <li>Automatic creation of GWT components.</li>
        </ul>
      ]]>
  </description>
  <resource-bundle>messages.GwtBundle</resource-bundle>

