<idea-plugin>

  <extensions defaultExtensionNs="org.jetbrains.idea.maven">
    <importer implementation="org.randombits.intellij.gwt.maven.GwtTotspFacetImporter" order="after web"/>
    <importer implementation="org.randombits.intellij.gwt.maven.GwtCodehausFacetImporter" order="after web"/>
    <importer implementation="org.randombits.intellij.gwt.maven.GwtLtgtFacetImporter" order="after web"/>
    <importer implementation="org.randombits.intellij.gwt.maven.GwtLtgtModuleImporter" order="last"/>

  </extensions>

  <projectListeners>
    <listener class="org.randombits.intellij.gwt.maven.GwtMavenProjectResolutionListener"
              topic="org.jetbrains.idea.maven.project.MavenProjectsTree$Listener"/>
  </projectListeners>

  <extensions defaultExtensionNs="org.randombits.intellij.gwt">
    <sdkType implementation="org.randombits.intellij.gwt.maven.GwtMavenSdkType"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <projectService serviceImplementation="org.randombits.intellij.gwt.maven.GwtLtgtModuleWatcher"/>
  </extensions>
</idea-plugin>
