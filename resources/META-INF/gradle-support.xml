<idea-plugin>
  <extensions defaultExtensionNs="org.randombits.intellij.gwt">
    <sdkType implementation="org.randombits.intellij.gwt.gradle.GwtGradleSdkType"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <externalProjectDataService implementation="org.randombits.intellij.gwt.gradle.GwtDependencyDataService"/>
    <externalProjectDataService implementation="org.randombits.intellij.gwt.gradle.GwtArtifactsDataService"/>
  </extensions>
  <extensions defaultExtensionNs="org.jetbrains.plugins.gradle">
    <executionEnvironmentProvider implementation="org.randombits.intellij.gwt.gradle.GwtGradleExecutionEnvironmentProvider"/>
  </extensions>
</idea-plugin>
